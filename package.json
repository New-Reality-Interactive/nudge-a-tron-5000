{
  "name": "nudge-a-tron-5000",
  "version": "0.0.0",
  "private": true,
  "description": "Nagging-reminder REST API on Cloudflare Workers + Durable Objects",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --project unit --coverage",
    "openapi": "vitest run --project unit test/unit/http/v0/openapi.test.ts --update",
    "openapi:check": "vitest run --project unit test/unit/http/v0/openapi.test.ts --update=none"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.9",
    "rrule-temporal": "^2.2.7",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "miniflare": {
        "sharp": "0.35.4"
      }
    }
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
